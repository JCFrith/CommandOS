# CommandOS environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---
# Auth is enabled automatically when the two NEXT_PUBLIC_* values below are set.
# Configure OAuth providers (Google, GitHub) in the Supabase dashboard and add
# <NEXT_PUBLIC_APP_URL>/auth/callback as an allowed redirect URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
